<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:EmergencyApp.User.Views"
       x:Class="EmergencyApp.User.AppShell"
       FlyoutBehavior="Disabled">

    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Title="SOS" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="History" ContentTemplate="{DataTemplate views:HistoryPage}" />
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>
</Shell>
