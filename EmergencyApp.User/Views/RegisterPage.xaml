<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmergencyApp.User.ViewModels"
             x:Class="EmergencyApp.User.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Create account"
             Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="14">
            <Entry Placeholder="Full name" Text="{Binding FullName}" />
            <Entry Placeholder="Phone number" Keyboard="Telephone" Text="{Binding Phone}" />
            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="Password (min 6 characters)" IsPassword="True" Text="{Binding Password}" />
            <Label Text="{Binding Error}" TextColor="{StaticResource Primary}" />
            <Button Text="Register" Command="{Binding RegisterCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
