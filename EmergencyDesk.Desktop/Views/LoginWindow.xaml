<Window x:Class="EmergencyDesk.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emergency Desk - Sign in" Width="400" Height="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="24" Padding="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EMERGENCY DESK" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Sign in" Style="{StaticResource Heading}" Margin="0,4,0,4"/>
            <TextBlock Text="Admin and dispatcher access only." Style="{StaticResource Muted}" Margin="0,0,0,22"/>

            <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" KeyDown="Field_KeyDown" Margin="0,0,0,14"/>

            <TextBlock Text="Password" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PassBox" KeyDown="Field_KeyDown" Margin="0,0,0,10"/>

            <TextBlock x:Name="ErrorText" Foreground="#FF8A8E" TextWrapping="Wrap" MinHeight="32"/>

            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                    Margin="0,8,0,0" Padding="14,10" Click="SignIn_Click"/>
        </StackPanel>
    </Border>
</Window>
